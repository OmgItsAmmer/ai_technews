# ---- Required ----
AI_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.neon.tech/neondb?sslmode=require
AI_SERVICE_KEY=generate-a-long-random-string-at-least-24-chars   # shared with Django (AI_SERVICE_KEY)

# ---- Infra ----
AI_REDIS_URL=redis://localhost:6381/2   # docker compose redis; any Redis works
AI_ENV=dev                 # dev | test | prod
AI_LOG_JSON=false

# ---- Models (any OpenAI-compatible endpoint works: OpenAI, vLLM, Ollama, ngrok) ----
AI_FAST__PROVIDER=openai          # openai | anthropic | offline
AI_FAST__MODEL=gpt-4o-mini
AI_FAST__API_KEY=sk-...
# AI_FAST__BASE_URL=http://localhost:11434/v1
# AI_FAST__DISABLE_THINKING=true  # Qwen3-style reasoning models

AI_STRONG__PROVIDER=openai
AI_STRONG__MODEL=gpt-4o
AI_STRONG__API_KEY=sk-...
# Optional fallback when the strong model is down
# AI_STRONG_FALLBACK__PROVIDER=openai
# AI_STRONG_FALLBACK__MODEL=gpt-4o-mini
# AI_STRONG_FALLBACK__API_KEY=sk-...

# Embeddings. Dimension is baked into the DB schema at migration time.
AI_EMBED_PROVIDER=openai          # openai | offline (hashing, for dev/CI only)
AI_EMBED_MODEL=text-embedding-3-small
AI_EMBED_DIM=1536
AI_EMBED_API_KEY=sk-...

# Reranking: llm (fast model, default) | http (TEI/Cohere/Jina) | none
AI_RERANK=llm
# AI_RERANK_URL=http://localhost:8080/rerank
