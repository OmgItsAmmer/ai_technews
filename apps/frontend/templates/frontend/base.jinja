<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rapid News</title>
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet">
    <!-- Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
    <!-- Styles -->
    <link rel="stylesheet" href="{{ static('frontend/css/main.css') }}">
    <!-- Markdown Parser -->
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <style>
        html {
            scroll-behavior: smooth;
        }
        body {
            -webkit-overflow-scrolling: touch;
        }
        @keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        .icon-btn.fetching {
            cursor: not-allowed;
            opacity: 0.8;
        }
        /* Floating Navbar Styles */
        .navbar {
            background: rgba(10, 10, 10, 0.85) !important;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            margin: 12px 24px 0 24px !important;
            border-radius: 12px !important;
            border: 0.5px solid var(--border) !important;
            position: sticky !important;
            top: 12px !important;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4) !important;
        }
        /* Card Visibility and Transition on Scroll */
        .card {
            opacity: 0;
            transform: translateY(20px);
            transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s, box-shadow 0.2s ease !important;
        }
        .card.card-visible {
            opacity: 1;
            transform: translateY(0);
        }
        .card.card-visible:hover {
            transform: translateY(-4px) !important;
        }
        /* Rounded Search Focus Style */
        #search-in:focus {
            border-color: var(--border-hover) !important;
            background-color: rgba(255, 255, 255, 0.08) !important;
        }
    </style>
</head>
<body>
    <nav class="navbar">
        <div class="nav-left">
            <a href="/" class="logo">Rapid News</a>
            <div id="global-fetch-loader" style="display: none; align-items: center; gap: 6px; margin-left: 18px; font-size: 13px; color: var(--red); font-weight: 500; font-family: var(--font-body);">
                <i class="ti ti-loader-2" style="display: inline-block; animation: spin 1s linear infinite;" aria-hidden="true"></i>
                Fetching latest news...
            </div>
        </div>
        <div class="nav-center" style="display: flex; align-items: center; gap: 24px;">
            <div class="nav-links">
                <a href="/" {% if active_page == 'feed' %}class="active"{% endif %}>Feed</a>
                <a href="/saved" {% if active_page == 'saved' %}class="active"{% endif %}>Saved</a>
            </div>
            {% if active_page in ['feed', 'saved'] %}
            <div class="search-wrap" style="position: relative; width: 280px;">
                <i class="ti ti-search" aria-hidden="true" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); font-size: 14px; color: var(--text-dim); pointer-events: none;"></i>
                <input type="text" id="search-in" name="q" placeholder="Search articles..." value="{{ active_q or '' }}" style="width: 100%; background: rgba(255,255,255,0.05); border: 0.5px solid var(--border); border-radius: 99px; padding: 8px 16px 8px 38px; font-size: 13px; font-family: var(--font-body); color: var(--text); outline: none; transition: border-color 0.15s, background-color 0.15s;">
            </div>
            {% endif %}
        </div>
        <div class="nav-right" style="display: flex; align-items: center; gap: 10px;">
            <button class="ai-btn" onclick="toggleAskAiDrawer()">
                <i class="ti ti-sparkles" aria-hidden="true"></i> Ask AI
            </button>
            <button id="fetch-btn" class="icon-btn" onclick="fetchLatestNews()">
                <i class="ti ti-refresh" aria-hidden="true"></i> Fetch latest
            </button>
            <button id="copy-btn" class="icon-btn" onclick="copyToken()">
                <i class="ti ti-copy" aria-hidden="true"></i> Copy session
            </button>
        </div>
    </nav>

    <main class="container">
        {% block content %}{% endblock %}
    </main>

    <!-- Modal Popup -->
    <div id="card-modal" class="modal-overlay" onclick="closeModal(event)">
        <div class="modal-content" onclick="event.stopPropagation()">
            <button class="modal-close" onclick="closeModal()"><i class="ti ti-x"></i></button>
            <div id="modal-body"></div>
        </div>
    </div>

    <!-- Ask AI Chat Drawer -->
    <div id="ask-ai-backdrop" class="chat-backdrop" onclick="closeAskAiDrawer(event)">
        <div class="chat-panel" onclick="event.stopPropagation()">
            <div class="chat-header">
                <h3><i class="ti ti-sparkles"></i> Ask AI Intelligence</h3>
                <button class="modal-close" onclick="closeAskAiDrawer()" style="position: static;"><i class="ti ti-x"></i></button>
            </div>
            <div id="chat-messages" class="chat-messages">
                <div class="chat-bubble ai">
                    Hello! I'm your AI intelligence assistant powered by Scrutinize. Ask me anything about recent tech news, AI developments, or industry trends!
                </div>
            </div>
            <div class="chat-input-wrap">
                <input type="text" id="chat-input" class="chat-input" placeholder="Ask a question about AI news..." onkeydown="if(event.key === 'Enter') sendChatMessage()">
                <button id="chat-send" class="chat-send-btn" onclick="sendChatMessage()"><i class="ti ti-send"></i></button>
            </div>
        </div>
    </div>

    <script>
        // Session Token System
        function getOrCreateToken() {
            let t = localStorage.getItem('ainews_token');
            if (!t) {
                t = 'sess_' + Math.random().toString(36).slice(2, 10) + Math.random().toString(36).slice(2, 10);
                localStorage.setItem('ainews_token', t);
            }
            return t;
        }

        function fallbackCopyTextToClipboard(text) {
            var textArea = document.createElement("textarea");
            textArea.value = text;
            textArea.style.top = "0";
            textArea.style.left = "0";
            textArea.style.position = "fixed";
            document.body.appendChild(textArea);
            textArea.focus();
            textArea.select();
            try {
                document.execCommand('copy');
            } catch (err) {}
            document.body.removeChild(textArea);
        }

        // Copy session to clipboard
        function copyToken() {
            const t = getOrCreateToken();
            let textToCopy = t;
            if (window.location.protocol !== 'file:') {
                textToCopy = window.location.origin + '/saved?token=' + t;
            }
            
            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(textToCopy).catch(() => fallbackCopyTextToClipboard(textToCopy));
            } else {
                fallbackCopyTextToClipboard(textToCopy);
            }

            const btn = document.getElementById('copy-btn');
            btn.innerHTML = '<i class="ti ti-check" aria-hidden="true"></i> Copied';
            btn.classList.add('copied');
            setTimeout(() => {
                btn.innerHTML = '<i class="ti ti-copy" aria-hidden="true"></i> Copy session';
                btn.classList.remove('copied');
            }, 2000);
        }
        
        // Hydrate save state across the page
        async function hydrateSaved() {
            const token = getOrCreateToken();
            try {
                const res = await fetch('/api/saved?token=' + token);
                if (res.ok) {
                    const { post_ids } = await res.json();
                    document.querySelectorAll('.save-btn').forEach(btn => {
                        const id = parseInt(btn.dataset.id);
                        if (post_ids.includes(id)) {
                            btn.classList.add('saved');
                            const icon = btn.querySelector('i');
                            if (icon) icon.classList.replace('ti-bookmark', 'ti-bookmark-filled');
                        }
                    });
                }
            } catch (e) {
                console.error("Failed to hydrate saved state", e);
            }
        }
        
        // Save/Unsave function
        async function toggleSave(btn, postId) {
            const token = getOrCreateToken();
            const saved = btn.classList.contains('saved');
            const method = saved ? 'DELETE' : 'POST';
            
            // Optimistic UI update
            if (saved) {
                btn.classList.remove('saved');
                btn.querySelector('i').classList.replace('ti-bookmark-filled', 'ti-bookmark');
            } else {
                btn.classList.add('saved');
                btn.querySelector('i').classList.replace('ti-bookmark', 'ti-bookmark-filled');
            }
            btn.classList.remove('animating');
            void btn.offsetWidth; // trigger reflow
            btn.classList.add('animating');
            btn.addEventListener('animationend', () => btn.classList.remove('animating'), { once: true });

            try {
                const csrfToken = document.querySelector('[name=csrfmiddlewaretoken]')?.value;
                const headers = { 'Content-Type': 'application/json' };
                if (csrfToken) {
                    headers['X-CSRFToken'] = csrfToken;
                }
                
                await fetch('/api/save', {
                    method,
                    headers: headers,
                    body: JSON.stringify({ token, post_id: parseInt(postId) })
                });
            } catch (e) {
                console.error("Failed to save/unsave", e);
                // Revert UI if failed
                if (saved) {
                    btn.classList.add('saved');
                    btn.querySelector('i').classList.replace('ti-bookmark', 'ti-bookmark-filled');
                } else {
                    btn.classList.remove('saved');
                    btn.querySelector('i').classList.replace('ti-bookmark-filled', 'ti-bookmark');
                }
            }
        }
        
        // Modal logic
        function openModal(btn) {
            const card = btn.closest('.card');
            const title = card.querySelector('.card-title').textContent;
            // The textContent of a line-clamped element retains the full original text.
            const summary = card.querySelector('.card-summary').textContent;
            const tagsHtml = card.querySelector('.card-tags').innerHTML;
            const metaHtml = card.querySelector('.card-footer').innerHTML;
            
            const modalBody = document.getElementById('modal-body');
            modalBody.innerHTML = `
                <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--text); margin-bottom: 16px; letter-spacing: 0.04em; line-height: 1.1; padding-right: 24px;">${title}</h2>
                <div class="card-tags" style="margin-bottom: 24px;">${tagsHtml}</div>
                <p style="font-size: 16px; color: rgba(255, 255, 255, 0.95); line-height: 1.6; margin-bottom: 32px;">${summary}</p>
                <div class="card-footer" style="border-top: 1px solid var(--border); padding-top: 16px; display: flex; justify-content: space-between; align-items: flex-end;">${metaHtml}</div>
            `;
            
            document.getElementById('card-modal').classList.add('open');
            document.body.style.overflow = 'hidden';
        }

        function closeModal(e) {
            if (e && e.target !== e.currentTarget && e.target.closest('.modal-close') === null) return;
            document.getElementById('card-modal').classList.remove('open');
            document.body.style.overflow = '';
        }

        function checkReadMore() {
            document.querySelectorAll('.card-summary').forEach(p => {
                if (p.scrollHeight > p.clientHeight) {
                    p.nextElementSibling.style.display = 'inline-block';
                } else {
                    p.nextElementSibling.style.display = 'none';
                }
            });
        }

        // Initial token generation and hydration check
        document.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const tokenFromUrl = urlParams.get('token');
            if (tokenFromUrl && tokenFromUrl.startsWith('sess_')) {
                localStorage.setItem('ainews_token', tokenFromUrl);
            }
            
            const token = getOrCreateToken();
            
            // Dynamically append token to Saved navbar link
            const savedLinks = document.querySelectorAll('a[href="/saved"], a[href^="/saved?"]');
            savedLinks.forEach(link => {
                link.href = '/saved?token=' + token;
            });
            
            // Redirect immediately if on /saved page without a token param
            if (window.location.pathname === '/saved' && !urlParams.has('token')) {
                window.location.href = '/saved?token=' + token;
                return;
            }
            
            hydrateSaved();
            setTimeout(checkReadMore, 100);
            window.addEventListener('resize', checkReadMore);
            if (typeof observeCards === 'function') observeCards();
            if (typeof applyHighlightsAndTagColors === 'function') applyHighlightsAndTagColors();
        });

        async function fetchLatestNews() {
            const btn = document.getElementById('fetch-btn');
            if (btn.classList.contains('fetching')) return;
            
            btn.classList.add('fetching');
            btn.innerHTML = '<i class="ti ti-loader-2" style="display: inline-block; animation: spin 1s linear infinite;" aria-hidden="true"></i> Fetching latest news...';
            
            const globalLoader = document.getElementById('global-fetch-loader');
            if (globalLoader) {
                globalLoader.style.display = 'flex';
            }
            
            try {
                const csrfToken = document.querySelector('[name=csrfmiddlewaretoken]')?.value;
                const headers = { 'Content-Type': 'application/json' };
                if (csrfToken) {
                    headers['X-CSRFToken'] = csrfToken;
                }
                
                const res = await fetch('/api/fetch-latest', { 
                    method: 'POST',
                    headers: headers
                });
                
                if (res.ok) {
                    btn.innerHTML = '<i class="ti ti-check" aria-hidden="true"></i> Started';
                    btn.style.borderColor = 'var(--red)';
                    btn.style.color = 'var(--red)';
                    
                    // If reloadFeed exists (we are on the feed page), auto reload feed after 8 seconds
                    if (typeof reloadFeed === 'function') {
                        setTimeout(() => {
                            reloadFeed().finally(() => {
                                if (globalLoader) globalLoader.style.display = 'none';
                            });
                        }, 8000);
                    } else {
                        setTimeout(() => {
                            if (globalLoader) globalLoader.style.display = 'none';
                        }, 8000);
                    }
                } else {
                    btn.innerHTML = '<i class="ti ti-x" aria-hidden="true"></i> Failed';
                    if (globalLoader) globalLoader.style.display = 'none';
                }
            } catch (e) {
                console.error("Failed to trigger fetch", e);
                btn.innerHTML = '<i class="ti ti-x" aria-hidden="true"></i> Failed';
                if (globalLoader) globalLoader.style.display = 'none';
            }
            
            setTimeout(() => {
                btn.classList.remove('fetching');
                btn.innerHTML = '<i class="ti ti-refresh" aria-hidden="true"></i> Fetch latest';
                btn.style.borderColor = '';
                btn.style.color = '';
            }, 3000);
        }

        // IntersectionObserver for fading in/out cards on scroll
        const cardObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('card-visible');
                } else {
                    entry.target.classList.remove('card-visible');
                }
            });
        }, {
            threshold: 0.02,
            rootMargin: "0px 0px -20px 0px"
        });

        function observeCards() {
            document.querySelectorAll('.card').forEach(card => {
                cardObserver.observe(card);
            });
        }

        // Ask AI Chatbot Logic
        let pageSessionId = 'page_' + Math.random().toString(36).slice(2, 9);
        
        function toggleAskAiDrawer() {
            const backdrop = document.getElementById('ask-ai-backdrop');
            backdrop.classList.add('open');
            document.body.style.overflow = 'hidden';
            setTimeout(() => document.getElementById('chat-input').focus(), 100);
            loadChatHistory();
        }

        function closeAskAiDrawer(e) {
            if (e && e.target !== e.currentTarget && !e.target.closest('.modal-close')) return;
            document.getElementById('ask-ai-backdrop').classList.remove('open');
            document.body.style.overflow = '';
        }

        async function loadChatHistory() {
            const token = getOrCreateToken();
            try {
                const res = await fetch(`/api/chat/history?token=${token}&page_session_id=${pageSessionId}`);
                if (res.ok) {
                    const data = await res.json();
                    if (data.messages && data.messages.length > 0) {
                        renderMessages(data.messages);
                    }
                }
            } catch (e) {
                console.error("Failed loading chat history", e);
            }
        }

        function renderMessages(messages) {
            const container = document.getElementById('chat-messages');
            container.innerHTML = '';
            messages.forEach(msg => {
                const bubble = document.createElement('div');
                bubble.className = `chat-bubble ${msg.role}`;
                
                if (msg.role === 'assistant') {
                    if (typeof marked !== 'undefined') {
                        bubble.innerHTML = marked.parse ? marked.parse(msg.content) : marked(msg.content);
                    } else {
                        bubble.textContent = msg.content;
                    }
                } else {
                    bubble.textContent = msg.content;
                }
                
                if (msg.role === 'assistant' && msg.citations && msg.citations.length > 0) {
                    const citWrap = document.createElement('div');
                    citWrap.className = 'chat-citations';
                    msg.citations.forEach(c => {
                        const card = document.createElement('div');
                        card.className = 'chat-citation-card';
                        const urlAttr = c.url ? `onclick="window.open('${c.url.replace(/'/g, "\\'")}', '_blank')"` : '';
                        const styleAttr = c.url ? 'style="cursor:pointer;"' : '';
                        card.innerHTML = `
                            <div class="chat-citation-title" ${urlAttr} ${styleAttr}>
                                <span>[#${c.index}] ${c.title}</span>
                                ${c.url ? '<i class="ti ti-external-link" style="color:var(--red);"></i>' : ''}
                            </div>
                            <div class="chat-citation-meta">${c.source_name} ${c.date ? '• ' + c.date : ''}</div>
                            ${c.snippet ? `<div class="chat-citation-snippet">"${c.snippet}..."</div>` : ''}
                        `;
                        citWrap.appendChild(card);
                    });
                    bubble.appendChild(citWrap);
                }
                container.appendChild(bubble);
            });
            container.scrollTop = container.scrollHeight;
        }

        async function sendChatMessage() {
            const input = document.getElementById('chat-input');
            const btn = document.getElementById('chat-send');
            const message = input.value.trim();
            if (!message) return;

            input.value = '';
            btn.disabled = true;

            const container = document.getElementById('chat-messages');
            
            // Append user bubble
            const userBubble = document.createElement('div');
            userBubble.className = 'chat-bubble user';
            userBubble.textContent = message;
            container.appendChild(userBubble);

            // Append typing indicator
            const typingBubble = document.createElement('div');
            typingBubble.className = 'chat-bubble ai';
            typingBubble.id = 'typing-bubble';
            typingBubble.innerHTML = '<div class="typing-indicator"><span></span><span></span><span></span></div>';
            container.appendChild(typingBubble);
            container.scrollTop = container.scrollHeight;

            const token = getOrCreateToken();
            try {
                const res = await fetch('/api/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        session_token: token,
                        page_session_id: pageSessionId,
                        message: message
                    })
                });

                const typing = document.getElementById('typing-bubble');
                if (typing) typing.remove();

                if (res.ok) {
                    const data = await res.json();
                    if (data.messages) {
                        renderMessages(data.messages);
                    }
                } else {
                    const errBubble = document.createElement('div');
                    errBubble.className = 'chat-bubble ai';
                    errBubble.textContent = "Sorry, I encountered an error answering your request.";
                    container.appendChild(errBubble);
                }
            } catch (e) {
                const typing = document.getElementById('typing-bubble');
                if (typing) typing.remove();
                const errBubble = document.createElement('div');
                errBubble.className = 'chat-bubble ai';
                errBubble.textContent = "Network error communicating with Ask AI.";
                container.appendChild(errBubble);
            } finally {
                btn.disabled = false;
                container.scrollTop = container.scrollHeight;
                input.focus();
            }
        }
    </script>
</body>
</html>
