<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ANTIX News</title>
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet">
    <!-- Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
    <!-- Styles -->
    <link rel="stylesheet" href="{{ static('frontend/css/main.css') }}">
    <style>
        html {
            scroll-behavior: smooth;
        }
        body {
            -webkit-overflow-scrolling: touch;
        }
        @keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        .icon-btn.fetching {
            cursor: not-allowed;
            opacity: 0.8;
        }
        /* Floating Navbar Styles */
        .navbar {
            background: rgba(10, 10, 10, 0.85) !important;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            margin: 12px 24px 0 24px !important;
            border-radius: 12px !important;
            border: 0.5px solid var(--border) !important;
            position: sticky !important;
            top: 12px !important;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4) !important;
        }
        /* Card Visibility and Transition on Scroll */
        .card {
            opacity: 0;
            transform: translateY(20px);
            transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s, box-shadow 0.2s ease !important;
        }
        .card.card-visible {
            opacity: 1;
            transform: translateY(0);
        }
        .card.card-visible:hover {
            transform: translateY(-4px) !important;
        }
        /* Rounded Search Focus Style */
        #search-in:focus {
            border-color: var(--border-hover) !important;
            background-color: rgba(255, 255, 255, 0.08) !important;
        }
    </style>
</head>
<body>
    <nav class="navbar">
        <div class="nav-left">
            <a href="/" class="logo">ANTIX News</a>
            <div id="global-fetch-loader" style="display: none; align-items: center; gap: 6px; margin-left: 18px; font-size: 13px; color: var(--red); font-weight: 500; font-family: var(--font-body);">
                <i class="ti ti-loader-2" style="display: inline-block; animation: spin 1s linear infinite;" aria-hidden="true"></i>
                Fetching latest news...
            </div>
        </div>
        <div class="nav-center" style="display: flex; align-items: center; gap: 24px;">
            <div class="nav-links">
                <a href="/" {% if active_page == 'feed' %}class="active"{% endif %}>Feed</a>
                <a href="/saved" {% if active_page == 'saved' %}class="active"{% endif %}>Saved</a>
            </div>
            {% if active_page in ['feed', 'saved'] %}
            <div class="search-wrap" style="position: relative; width: 280px;">
                <i class="ti ti-search" aria-hidden="true" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); font-size: 14px; color: var(--text-dim); pointer-events: none;"></i>
                <input type="text" id="search-in" name="q" placeholder="Search articles..." value="{{ active_q or '' }}" style="width: 100%; background: rgba(255,255,255,0.05); border: 0.5px solid var(--border); border-radius: 99px; padding: 8px 16px 8px 38px; font-size: 13px; font-family: var(--font-body); color: var(--text); outline: none; transition: border-color 0.15s, background-color 0.15s;">
            </div>
            {% endif %}
        </div>
        <div class="nav-right">
            <button id="fetch-btn" class="icon-btn" onclick="fetchLatestNews()">
                <i class="ti ti-refresh" aria-hidden="true"></i> Fetch latest
            </button>
            <button id="copy-btn" class="icon-btn" onclick="copyToken()">
                <i class="ti ti-copy" aria-hidden="true"></i> Copy session
            </button>
            <button id="chat-btn" class="icon-btn ai-btn" onclick="toggleChatPanel()" aria-label="Antix AI" aria-expanded="false">
                <i class="ti ti-sparkles" aria-hidden="true"></i> Antix AI
            </button>
        </div>
    </nav>

    <main class="container">
        {% block content %}{% endblock %}
    </main>

    <!-- AI Chat Panel -->
    <div id="chat-backdrop" class="chat-backdrop" onclick="closeChatPanel()" aria-hidden="true"></div>
    <aside id="chat-panel" class="chat-panel" role="dialog" aria-label="Antix AI" aria-modal="true">
        <div class="chat-panel-header">
            <div class="chat-panel-title">
                <i class="ti ti-sparkles" aria-hidden="true"></i>
                Antix AI
            </div>
            <button type="button" class="chat-panel-close" onclick="closeChatPanel()" aria-label="Close chat">
                <i class="ti ti-x" aria-hidden="true"></i>
            </button>
        </div>
        <div id="chat-messages" class="chat-messages">
            <div class="chat-empty" id="chat-empty">
                <i class="ti ti-message-chatbot" aria-hidden="true"></i>
                Ask about recent AI news. I'll cite articles from the feed.
            </div>
        </div>
        <div class="chat-input-area">
            <div class="chat-input-wrap">
                <textarea id="chat-input" class="chat-input" rows="1" placeholder="Ask a question…" aria-label="Chat message"></textarea>
            </div>
            <button type="button" id="chat-send-btn" class="chat-send-btn" onclick="sendChatMessage()" aria-label="Send message" disabled>
                <i class="ti ti-arrow-up" aria-hidden="true"></i>
            </button>
        </div>
    </aside>

    <!-- Modal Popup -->
    <div id="card-modal" class="modal-overlay" onclick="closeModal(event)">
        <div class="modal-content" onclick="event.stopPropagation()">
            <button class="modal-close" onclick="closeModal()"><i class="ti ti-x"></i></button>
            <div id="modal-body"></div>
        </div>
    </div>

    <script>
        // Session Token System
        function getOrCreateToken() {
            let t = localStorage.getItem('ainews_token');
            if (!t) {
                t = 'sess_' + Math.random().toString(36).slice(2, 10) + Math.random().toString(36).slice(2, 10);
                localStorage.setItem('ainews_token', t);
            }
            return t;
        }

        function fallbackCopyTextToClipboard(text) {
            var textArea = document.createElement("textarea");
            textArea.value = text;
            textArea.style.top = "0";
            textArea.style.left = "0";
            textArea.style.position = "fixed";
            document.body.appendChild(textArea);
            textArea.focus();
            textArea.select();
            try {
                document.execCommand('copy');
            } catch (err) {}
            document.body.removeChild(textArea);
        }

        // Copy session to clipboard
        function copyToken() {
            const t = getOrCreateToken();
            let textToCopy = t;
            if (window.location.protocol !== 'file:') {
                textToCopy = window.location.origin + '/saved?token=' + t;
            }
            
            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(textToCopy).catch(() => fallbackCopyTextToClipboard(textToCopy));
            } else {
                fallbackCopyTextToClipboard(textToCopy);
            }

            const btn = document.getElementById('copy-btn');
            btn.innerHTML = '<i class="ti ti-check" aria-hidden="true"></i> Copied';
            btn.classList.add('copied');
            setTimeout(() => {
                btn.innerHTML = '<i class="ti ti-copy" aria-hidden="true"></i> Copy session';
                btn.classList.remove('copied');
            }, 2000);
        }
        
        // Hydrate save state across the page
        async function hydrateSaved() {
            const token = getOrCreateToken();
            try {
                const res = await fetch('/api/saved?token=' + token);
                if (res.ok) {
                    const { post_ids } = await res.json();
                    document.querySelectorAll('.save-btn').forEach(btn => {
                        const id = parseInt(btn.dataset.id);
                        if (post_ids.includes(id)) {
                            btn.classList.add('saved');
                            const icon = btn.querySelector('i');
                            if (icon) icon.classList.replace('ti-bookmark', 'ti-bookmark-filled');
                        }
                    });
                }
            } catch (e) {
                console.error("Failed to hydrate saved state", e);
            }
        }
        
        // Save/Unsave function
        async function toggleSave(btn, postId) {
            const token = getOrCreateToken();
            const saved = btn.classList.contains('saved');
            const method = saved ? 'DELETE' : 'POST';
            
            // Optimistic UI update
            if (saved) {
                btn.classList.remove('saved');
                btn.querySelector('i').classList.replace('ti-bookmark-filled', 'ti-bookmark');
            } else {
                btn.classList.add('saved');
                btn.querySelector('i').classList.replace('ti-bookmark', 'ti-bookmark-filled');
            }
            btn.classList.remove('animating');
            void btn.offsetWidth; // trigger reflow
            btn.classList.add('animating');
            btn.addEventListener('animationend', () => btn.classList.remove('animating'), { once: true });

            try {
                const csrfToken = document.querySelector('[name=csrfmiddlewaretoken]')?.value;
                const headers = { 'Content-Type': 'application/json' };
                if (csrfToken) {
                    headers['X-CSRFToken'] = csrfToken;
                }
                
                await fetch('/api/save', {
                    method,
                    headers: headers,
                    body: JSON.stringify({ token, post_id: parseInt(postId) })
                });
            } catch (e) {
                console.error("Failed to save/unsave", e);
                // Revert UI if failed
                if (saved) {
                    btn.classList.add('saved');
                    btn.querySelector('i').classList.replace('ti-bookmark', 'ti-bookmark-filled');
                } else {
                    btn.classList.remove('saved');
                    btn.querySelector('i').classList.replace('ti-bookmark-filled', 'ti-bookmark');
                }
            }
        }
        
        // Modal logic
        function openModal(btn) {
            const card = btn.closest('.card');
            const title = card.querySelector('.card-title').textContent;
            // The textContent of a line-clamped element retains the full original text.
            const summary = card.querySelector('.card-summary').textContent;
            const tagsContainer = card.querySelector('.card-tags');
            let tagsHtml;
            if (tagsContainer.classList.contains('card-tags--conveyor')) {
                const track = tagsContainer.querySelector('.card-tags-track');
                const half = track ? track.children.length / 2 : 0;
                tagsHtml = track
                    ? Array.from(track.children).slice(0, half).map(t => t.outerHTML).join('')
                    : tagsContainer.innerHTML;
            } else {
                tagsHtml = tagsContainer.innerHTML;
            }
            const metaHtml = card.querySelector('.card-footer').innerHTML;
            
            const modalBody = document.getElementById('modal-body');
            modalBody.innerHTML = `
                <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--text); margin-bottom: 16px; letter-spacing: 0.04em; line-height: 1.1; padding-right: 24px;">${title}</h2>
                <div class="card-tags" style="margin-bottom: 24px;">${tagsHtml}</div>
                <p style="font-size: 16px; color: rgba(255, 255, 255, 0.95); line-height: 1.6; margin-bottom: 32px;">${summary}</p>
                <div class="card-footer" style="border-top: 1px solid var(--border); padding-top: 16px; display: flex; justify-content: space-between; align-items: flex-end;">${metaHtml}</div>
            `;
            
            document.getElementById('card-modal').classList.add('open');
            document.body.style.overflow = 'hidden';
        }

        function closeModal(e) {
            if (e && e.target !== e.currentTarget && e.target.closest('.modal-close') === null) return;
            document.getElementById('card-modal').classList.remove('open');
            document.body.style.overflow = '';
        }

        function checkReadMore() {
            document.querySelectorAll('.card-summary').forEach(p => {
                if (p.scrollHeight > p.clientHeight) {
                    p.nextElementSibling.style.display = 'inline-block';
                } else {
                    p.nextElementSibling.style.display = 'none';
                }
            });
        }

        function tagsWrap(container) {
            const tags = container.querySelectorAll(':scope > .card-tag');
            if (tags.length < 2) return false;
            const lineHeight = tags[0].offsetHeight;
            return container.scrollHeight > lineHeight + 2;
        }

        function restoreTagContainer(container) {
            if (container.dataset.conveyorActive !== '1') return;
            const track = container.querySelector('.card-tags-track');
            if (!track) return;
            const half = track.children.length / 2;
            const originals = Array.from(track.children).slice(0, half);
            container.replaceChildren(...originals);
            container.classList.remove('card-tags--conveyor');
            delete container.dataset.conveyorActive;
        }

        function buildTagConveyor(container, tagNodes) {
            container.dataset.conveyorActive = '1';
            container.classList.add('card-tags--conveyor');

            const viewport = document.createElement('div');
            viewport.className = 'card-tags-viewport';

            const track = document.createElement('div');
            track.className = 'card-tags-track';

            tagNodes.forEach(tag => track.appendChild(tag));
            tagNodes.forEach(tag => track.appendChild(tag.cloneNode(true)));

            viewport.appendChild(track);
            container.replaceChildren(viewport);

            requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                    const halfWidth = track.scrollWidth / 2;
                    if (halfWidth <= viewport.clientWidth) return;
                    const duration = Math.max(8, halfWidth / 32);
                    track.style.animation = `card-tags-conveyor ${duration}s linear infinite`;
                });
            });
        }

        function initTagConveyorForCard(card) {
            const container = card.querySelector('.card-tags');
            if (!container || container.closest('#card-modal')) return;

            restoreTagContainer(container);
            if (!tagsWrap(container)) return;

            const tags = Array.from(container.querySelectorAll(':scope > .card-tag'));
            if (tags.length < 2) return;
            buildTagConveyor(container, tags);
        }

        function initTagConveyors() {
            document.querySelectorAll('.card').forEach(card => initTagConveyorForCard(card));
        }

        function refreshCardTagUI() {
            checkReadMore();
            initTagConveyors();
            if (typeof applyHighlightsAndTagColors === 'function') {
                applyHighlightsAndTagColors();
            }
        }

        // Initial token generation and hydration check
        document.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const tokenFromUrl = urlParams.get('token');
            if (tokenFromUrl && tokenFromUrl.startsWith('sess_')) {
                localStorage.setItem('ainews_token', tokenFromUrl);
            }
            
            const token = getOrCreateToken();
            
            // Dynamically append token to Saved navbar link
            const savedLinks = document.querySelectorAll('a[href="/saved"], a[href^="/saved?"]');
            savedLinks.forEach(link => {
                link.href = '/saved?token=' + token;
            });
            
            // Redirect immediately if on /saved page without a token param
            if (window.location.pathname === '/saved' && !urlParams.has('token')) {
                window.location.href = '/saved?token=' + token;
                return;
            }
            
            hydrateSaved();
            setTimeout(refreshCardTagUI, 100);
            let resizeTimer;
            window.addEventListener('resize', () => {
                clearTimeout(resizeTimer);
                resizeTimer = setTimeout(refreshCardTagUI, 150);
            });
            if (typeof observeCards === 'function') observeCards();

            const chatInput = document.getElementById('chat-input');
            const chatSendBtn = document.getElementById('chat-send-btn');
            if (chatInput) {
                chatInput.addEventListener('input', () => {
                    chatInput.style.height = 'auto';
                    chatInput.style.height = Math.min(chatInput.scrollHeight, 120) + 'px';
                    chatSendBtn.disabled = !chatInput.value.trim() || chatLoading;
                });
                chatInput.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter' && !e.shiftKey) {
                        e.preventDefault();
                        sendChatMessage();
                    }
                });
            }
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && chatPanelOpen) closeChatPanel();
            });
        });

        async function fetchLatestNews() {
            const btn = document.getElementById('fetch-btn');
            if (btn.classList.contains('fetching')) return;
            
            btn.classList.add('fetching');
            btn.innerHTML = '<i class="ti ti-loader-2" style="display: inline-block; animation: spin 1s linear infinite;" aria-hidden="true"></i> Fetching latest news...';
            
            const globalLoader = document.getElementById('global-fetch-loader');
            if (globalLoader) {
                globalLoader.style.display = 'flex';
            }
            
            try {
                const csrfToken = document.querySelector('[name=csrfmiddlewaretoken]')?.value;
                const headers = { 'Content-Type': 'application/json' };
                if (csrfToken) {
                    headers['X-CSRFToken'] = csrfToken;
                }
                
                const res = await fetch('/api/fetch-latest', { 
                    method: 'POST',
                    headers: headers
                });
                
                if (res.ok) {
                    btn.innerHTML = '<i class="ti ti-check" aria-hidden="true"></i> Started';
                    btn.style.borderColor = 'var(--red)';
                    btn.style.color = 'var(--red)';
                    
                    // If reloadFeed exists (we are on the feed page), auto reload feed after 8 seconds
                    if (typeof reloadFeed === 'function') {
                        setTimeout(() => {
                            reloadFeed().finally(() => {
                                if (globalLoader) globalLoader.style.display = 'none';
                            });
                        }, 8000);
                    } else {
                        setTimeout(() => {
                            if (globalLoader) globalLoader.style.display = 'none';
                        }, 8000);
                    }
                } else {
                    btn.innerHTML = '<i class="ti ti-x" aria-hidden="true"></i> Failed';
                    if (globalLoader) globalLoader.style.display = 'none';
                }
            } catch (e) {
                console.error("Failed to trigger fetch", e);
                btn.innerHTML = '<i class="ti ti-x" aria-hidden="true"></i> Failed';
                if (globalLoader) globalLoader.style.display = 'none';
            }
            
            setTimeout(() => {
                btn.classList.remove('fetching');
                btn.innerHTML = '<i class="ti ti-refresh" aria-hidden="true"></i> Fetch latest';
                btn.style.borderColor = '';
                btn.style.color = '';
            }, 3000);
        }

        // IntersectionObserver for fading in/out cards on scroll
        const cardObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('card-visible');
                    initTagConveyorForCard(entry.target);
                    if (typeof applyHighlightsAndTagColors === 'function') {
                        applyHighlightsAndTagColors();
                    }
                } else {
                    entry.target.classList.remove('card-visible');
                }
            });
        }, {
            threshold: 0.02,
            rootMargin: "0px 0px -20px 0px"
        });

        function observeCards() {
            document.querySelectorAll('.card').forEach(card => {
                cardObserver.observe(card);
            });
        }

        // ── AI Chat Panel ──
        const chatPageSessionId = crypto.randomUUID();
        let chatPanelOpen = false;
        let chatLoading = false;

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function renderAnswerWithCitations(content, citations) {
            let html = escapeHtml(content);
            const urlByRef = {};
            (citations || []).forEach(c => { urlByRef[c.ref] = c.url; });

            html = html.replace(/\[(\d+)\]/g, (match, num) => {
                const ref = parseInt(num, 10);
                const url = urlByRef[ref];
                if (!url) return match;
                return `<a href="${escapeHtml(url)}" target="_blank" rel="noopener noreferrer" class="chat-cite-ref">[${ref}]</a>`;
            });
            return html;
        }

        function renderCitationsList(citations) {
            if (!citations || !citations.length) return '';
            const items = citations.map(c => `
                <a href="${escapeHtml(c.url)}" target="_blank" rel="noopener noreferrer" class="chat-source-link">
                    <span class="chat-source-ref">[${c.ref}]</span>
                    <span>
                        <div class="chat-source-title">${escapeHtml(c.title)}</div>
                        <div class="chat-source-meta">${escapeHtml(c.source_name)}</div>
                    </span>
                </a>
            `).join('');
            return `<div class="chat-sources"><div class="chat-sources-label">Sources</div>${items}</div>`;
        }

        function renderChatMessage(msg) {
            const bubble = document.createElement('div');
            bubble.className = `chat-bubble ${msg.role}`;

            if (msg.role === 'assistant') {
                bubble.innerHTML = renderAnswerWithCitations(msg.content, msg.citations) + renderCitationsList(msg.citations);
            } else {
                bubble.textContent = msg.content;
            }
            return bubble;
        }

        function renderAllChatMessages(messages) {
            const container = document.getElementById('chat-messages');
            const empty = document.getElementById('chat-empty');
            container.querySelectorAll('.chat-bubble, .chat-typing').forEach(el => el.remove());

            if (!messages.length) {
                if (empty) empty.style.display = '';
                return;
            }
            if (empty) empty.style.display = 'none';
            messages.forEach(msg => container.appendChild(renderChatMessage(msg)));
            container.scrollTop = container.scrollHeight;
        }

        function showChatTyping() {
            const container = document.getElementById('chat-messages');
            const empty = document.getElementById('chat-empty');
            if (empty) empty.style.display = 'none';
            const typing = document.createElement('div');
            typing.className = 'chat-typing';
            typing.id = 'chat-typing';
            typing.innerHTML = '<span></span><span></span><span></span>';
            container.appendChild(typing);
            container.scrollTop = container.scrollHeight;
        }

        function hideChatTyping() {
            document.getElementById('chat-typing')?.remove();
        }

        async function loadChatHistory() {
            try {
                const res = await fetch(
                    `/api/chat/history?session_token=${encodeURIComponent(getOrCreateToken())}&page_session_id=${encodeURIComponent(chatPageSessionId)}`
                );
                if (!res.ok) return;
                const data = await res.json();
                renderAllChatMessages(data.messages || []);
            } catch (e) {
                console.error('Failed to load chat history', e);
            }
        }

        async function sendChatMessage() {
            if (chatLoading) return;
            const input = document.getElementById('chat-input');
            const message = input.value.trim();
            if (!message) return;

            chatLoading = true;
            document.getElementById('chat-send-btn').disabled = true;
            input.disabled = true;

            const container = document.getElementById('chat-messages');
            const empty = document.getElementById('chat-empty');
            if (empty) empty.style.display = 'none';
            container.appendChild(renderChatMessage({ role: 'user', content: message }));
            input.value = '';
            input.style.height = 'auto';
            showChatTyping();
            container.scrollTop = container.scrollHeight;

            try {
                const csrfToken = document.querySelector('[name=csrfmiddlewaretoken]')?.value;
                const headers = { 'Content-Type': 'application/json' };
                if (csrfToken) headers['X-CSRFToken'] = csrfToken;

                const res = await fetch('/api/chat', {
                    method: 'POST',
                    headers,
                    body: JSON.stringify({
                        session_token: getOrCreateToken(),
                        page_session_id: chatPageSessionId,
                        message,
                    }),
                });

                hideChatTyping();

                if (!res.ok) {
                    const err = document.createElement('div');
                    err.className = 'chat-bubble error';
                    err.textContent = 'Something went wrong. Please try again.';
                    container.appendChild(err);
                } else {
                    const data = await res.json();
                    renderAllChatMessages(data.messages || []);
                }
            } catch (e) {
                hideChatTyping();
                console.error('Chat error', e);
                const err = document.createElement('div');
                err.className = 'chat-bubble error';
                err.textContent = 'Something went wrong. Please try again.';
                container.appendChild(err);
            } finally {
                chatLoading = false;
                input.disabled = false;
                document.getElementById('chat-send-btn').disabled = !input.value.trim();
                input.focus();
                container.scrollTop = container.scrollHeight;
            }
        }

        function openChatPanel() {
            chatPanelOpen = true;
            document.getElementById('chat-panel').classList.add('open');
            document.getElementById('chat-backdrop').classList.add('open');
            document.getElementById('chat-btn').classList.add('active');
            document.getElementById('chat-btn').setAttribute('aria-expanded', 'true');
            document.body.style.overflow = 'hidden';
            loadChatHistory();
            setTimeout(() => document.getElementById('chat-input').focus(), 320);
        }

        function closeChatPanel() {
            chatPanelOpen = false;
            document.getElementById('chat-panel').classList.remove('open');
            document.getElementById('chat-backdrop').classList.remove('open');
            document.getElementById('chat-btn').classList.remove('active');
            document.getElementById('chat-btn').setAttribute('aria-expanded', 'false');
            document.body.style.overflow = '';
        }

        function toggleChatPanel() {
            if (chatPanelOpen) closeChatPanel();
            else openChatPanel();
        }
    </script>
</body>
</html>
