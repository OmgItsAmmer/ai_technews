# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Neon PostgreSQL — copy the pooled connection string from the Neon dashboard
# Project → Connection Details → Connection string (use "Pooled connection")
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Redis — local Docker for development (run: docker-compose up -d)
# Production uses co-located Redis on Fly: redis://127.0.0.1:6379/0
REDIS_URL=redis://localhost:6379/0

# LLM Config (supports OpenAI or custom OpenAI-compatible local APIs like vLLM/Ollama via ngrok)
# Optional: Set OPENAI_BASE_URL to point to your local LLM deployment (e.g. ngrok/vLLM /v1 endpoint)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app/v1
LLM_MODEL=Qwen/Qwen3.5-4B

# External cron trigger — shared secret for POST /internal/trigger-fetch/
# Set the same value in GitHub Actions secrets (or your cron provider)
CRON_SECRET=change-me-to-a-long-random-string

DJANGO_SETTINGS_MODULE=config.settings.development
